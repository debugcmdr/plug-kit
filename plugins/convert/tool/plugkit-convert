def probe_duration(path):
    """ffprobe 获取时长(秒),用于进度计算。"""
    try:
        proc = subprocess.run(
            [FFPROBE, "-v", "error", "-show_entries", "format=duration",
             "-of", "json", path],
            capture_output=True, text=True, timeout=15,
        )
        d = json.loads(proc.stdout)
        return float(d.get("format", {}).get("duration", 0) or 0)
    except Exception:
        return 0


def run_ffmpeg(cmd, duration, label, file_name=None, output_path=None):
    """执行 ffmpeg,流式解析 time=/speed= 进度并估算 ETA。
    返回 (ok, err_detail, code):失败时 err_detail 为 stderr 尾部、code 为退出码,
    供「copy 失败降级转码」等重试场景复用,避免首次失败就输出错误。
    file_name/output_path 随进度上报,任务中心据此展示转换文件名与"打开输出文件夹"入口。"""
    try:
        proc = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1,
        )
    except FileNotFoundError:
        return False, "FFMPEG_MISSING", None

    last_pct = -1.0
    last_report = time.time()
    tail = []  # 保留 stderr/stdout 末尾(ffmpeg 合并输出),失败时作为诊断详情
    for line in proc.stdout:
        tail.append(line)
        if len(tail) > 8:
            tail.pop(0)
        m = re.search(r"time=(\d+):(\d+):([\d.]+)", line)
        s = re.search(r"speed=\s*([\d.]+)x", line)
        speed = float(s.group(1)) if s else None
        if m and duration > 0:
            elapsed = int(m.group(1)) * 3600 + int(m.group(2)) * 60 + float(m.group(3))
            pct = min(99.0, (elapsed / duration) * 100)
            # 剩余时长估算:剩余媒体时长 ÷ 当前处理速度(无速度则按实时计)。
            remaining = max(0.0, duration - elapsed)
            eta = remaining / speed if (speed and speed > 0) else remaining
            eta_str = format_hms(eta)
            speed_str = f"{speed:.2f}x" if speed else None
            now = time.time()
            # 1% 变化 或 每 2 秒 至少上报一次,保证 ETA 平滑刷新。
            if pct - last_pct >= 1 or (now - last_report) >= 2.0:
                progress(pct, message=label, speed=speed_str, eta=eta_str,
                         file_name=file_name, output_path=output_path)
                last_pct = pct
                last_report = now

    proc.wait()
    if proc.returncode != 0:
        return False, "".join(tail).strip()[-400:], proc.returncode
    return True, "", 0


def run_with_progress(cmd, duration, label, file_name=None, output_path=None):
    """执行 ffmpeg 并上报进度;失败时输出 FFMPEG_ERROR/FFMPEG_MISSING。"""
    ok, err, code = run_ffmpeg(cmd, duration, label, file_name, output_path)
    if not ok:
        if err == "FFMPEG_MISSING":
            error("FFMPEG_MISSING", "未找到 ffmpeg,请先安装共享依赖")
            return None
        # 带输出文件名:批量/并发转换时用户能定位是哪个文件失败(C-10)
        target = f" {file_name or os.path.basename(output_path or '')}"
        msg = f"ffmpeg 转换失败{target}。请检查输入文件是否损坏、所选格式是否支持、磁盘空间是否充足。"
        if err:
            msg += f" ｜ 详情: {err} (ffmpeg 退出码 {code})"
        else:
            msg += f" (ffmpeg 退出码 {code})"
        error("FFMPEG_ERROR", msg)
        return None
    return True


# ---------------------------------------------------------------- 输出路径安全化
def resolve_output(input_path, output_path):
    """安全化输出路径,杜绝数据丢失。绝不覆盖任何已存在文件。

    场景1(同路径): MP4→MP4 且输出==输入 —— ffmpeg 读改写同一文件会失败/损坏,
                  改为同目录 `_converted` 后缀。
    场景2(同名冲突): 设置了保存目录时,不同目录的同名文件(/a/1.mp4 与 /b/1.mp4)
                  都会映射到 saveDir/1.mp4,两个任务并发写同一路径 → 用原子占位
                  (O_CREAT|O_EXCL)保证同一路径只有一个任务拿到,其余自动加序号。
    """
    inp = os.path.abspath(input_path)
    out = os.path.abspath(output_path)
    if out == inp:
        d = os.path.dirname(out)
        base = os.path.splitext(os.path.basename(out))[0]
        ext = os.path.splitext(out)[1]
        return _reserve_path(os.path.join(d, f"{base}_converted{ext}"))
    return _reserve_path(out)


def _reserve_path(path):
    """原子占位输出路径:O_CREAT|O_EXCL 独占创建,并发窗口内不会有第二个任务拿到同一路径。
    已存在(含被并发占位)则追加 (1)(2)… 序号。ffmpeg 以 -y 覆盖占位文件。"""
    d = os.path.dirname(os.path.abspath(path)) or "."
    base = os.path.splitext(os.path.basename(path))[0]
    ext = os.path.splitext(path)[1]
    os.makedirs(d, exist_ok=True)
    cand = path
    i = 1
    # 上限保护(C-11):目录权限异常等场景下 O_EXCL 可能持续抛 FileExistsError
    # 之外的异常由上层捕获;这里仅防"序号已占满"的极端循环(理论上几乎不可能)。
    max_tries = 10000
    while i <= max_tries:
        try:
            fd = os.open(cand, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            os.close(fd)
            return cand
        except FileExistsError:
            cand = os.path.join(d, f"{base} ({i}){ext}")
            i += 1
    raise OSError(f"无法为输出路径分配唯一文件名(已尝试 {max_tries} 次): {path}")


def ensure_output_dir(output_path):
    """确保输出目录存在(用户选择的保存目录被删除时不会让 ffmpeg 直接失败)。"""
    d = os.path.dirname(os.path.abspath(output_path))
    if d:
        os.makedirs(d, exist_ok=True)


def cleanup_if_empty(path):
    """清理 0 字节占位文件:O_EXCL 占位在编码器缺失等提前失败分支未写入,
    残留的空文件会让用户误以为输出已生成。仅删 size==0 的文件,不动 ffmpeg 半成品。"""
    try:
        if os.path.exists(path) and os.path.getsize(path) == 0:
            os.remove(path)
    except Exception:
        pass


def _remove_output(path):
    """删除输出文件(含半成品),失败静默。用于「降级路径」:首次尝试失败的产物
    (可能 >0 字节)将被降级产物替代,残留只会误导用户(C-3)。"""
    try:
        if path and os.path.exists(path):
            os.remove(path)
    except Exception:
        pass


# ---------------------------------------------------------------- 视频转换
def convert_video(input_path, output_path, preset="medium", crf=None, audio_bitrate=None, codec=None, gif_fps=None, gif_width=None):
    """转换视频。提取音频是独立操作:UI 输出音频扩展名(如 .mp3)时由 main() 分发到 convert_audio。"""
    output_path = resolve_output(input_path, output_path)
    ensure_output_dir(output_path)
    duration = probe_duration(input_path)
    fname = os.path.basename(output_path)
    progress(0, message=f"开始转换视频 {os.path.basename(input_path)}...",
             file_name=fname, output_path=output_path)

    ext = os.path.splitext(output_path)[1].lower()
    preset_map = {"fast": "veryfast", "medium": "medium", "slow": "slow"}

    # 视频转 GIF(参数化:fps/宽度可调;scale 用 -2 保偶数,高度奇数会报错)
    if ext == ".gif":
        fps = gif_fps or "10"
        width = gif_width or "480"
        cmd = [FFMPEG, "-y", "-i", input_path,
               "-vf", f"fps={fps},scale={width}:-2:flags=lanczos", "-loop", "0"]
        cmd.append(output_path)
    elif ext == ".webm":
        # 双编码器防护:视频 vp9 + 音频 opus 任一缺失都应明确提示(而非 ffmpeg 裸报错)
        missing = [enc for enc in ("libvpx-vp9", "libopus") if not has_encoder(enc)]
        if missing:
            cleanup_if_empty(output_path)
            error("ENCODER_MISSING",
                  f"当前 ffmpeg 缺少 {', '.join(missing)} 编码器,无法转 WebM。可用: mp4/mkv/mov。{ENCODER_SELF_HELP}")
            return
        cmd = [FFMPEG, "-y", "-i", input_path,
               "-c:v", "libvpx-vp9", "-preset", preset_map.get(preset, "medium"),
               "-b:v", "0", "-crf", crf or "32", "-c:a", "libopus", "-b:a", audio_bitrate or "96k"]
        cmd.append(output_path)
    elif ext == ".mp4":
        if codec == "hevc":
            # H.265: 小体积但转码慢;缺编码器时给明确提示而不是 ffmpeg 报错。
            if not has_encoder("libx265"):
                cleanup_if_empty(output_path)
                error("ENCODER_MISSING", f"当前 ffmpeg 缺少 libx265 编码器,无法转 H.265。可用: H.264 (默认)。{ENCODER_SELF_HELP}")
                return
            cmd = [FFMPEG, "-y", "-i", input_path,
                   "-c:v", "libx265", "-preset", preset_map.get(preset, "medium"),
                   "-crf", crf or "23", "-tag:v", "hvc1", "-pix_fmt", "yuv420p",
                   "-c:a", "aac", "-b:a", audio_bitrate or "128k"]
        else:
            cmd = [FFMPEG, "-y", "-i", input_path,
                   "-c:v", "libx264", "-preset", preset_map.get(preset, "medium"),
                   "-crf", crf or "23", "-pix_fmt", "yuv420p", "-c:a", "aac",
                   "-b:a", audio_bitrate or "128k"]
        cmd.append(output_path)
    else:
        # mkv / mov / avi / m4v / ts / mpg / flv 等
        cmd = [FFMPEG, "-y", "-i", input_path]
        if ext == ".mkv" and codec == "hevc":
            # MKV 容器 + H.265(无需 hvc1 tag,那是 mp4 的要求)
            if not has_encoder("libx265"):
                cleanup_if_empty(output_path)
                error("ENCODER_MISSING", f"当前 ffmpeg 缺少 libx265 编码器,无法转 H.265。可用: H.264 (默认)。{ENCODER_SELF_HELP}")
                return
            cmd += ["-c:v", "libx265", "-preset", preset_map.get(preset, "medium"),
                    "-crf", crf or "23", "-c:a", "aac", "-b:a", audio_bitrate or "128k"]
        elif ext in (".avi", ".mpg", ".mpeg", ".flv"):
            # AVI / MPEG-PS 容器对 AAC 支持不佳(部分播放器打不开)→ 音频用 mp3 更兼容;
            # flv 同时支持 AAC,统一 mp3 保持分支简单。
            cmd += ["-c:v", "libx264", "-preset", preset_map.get(preset, "medium"),
                    "-crf", crf or "23", "-c:a", "libmp3lame", "-b:a", audio_bitrate or "128k"]
        elif ext in (".ts", ".m4v"):
            # copy 优先:快速无损封装。源编码与容器不兼容(如 vp9→m4v)时
            # ffmpeg 报错,降级转码 libx264 重试(避免"选了就必失败")。
            cmd += ["-c:v", "copy", "-c:a", "aac"]
        else:
            cmd += ["-c:v", "libx264", "-preset", preset_map.get(preset, "medium"),
                    "-crf", crf or "23", "-c:a", "aac"]
        cmd.append(output_path)

    # 保留源元数据(标题/日期等)。位置必须在输出文件参数之前,统一在各分支末尾注入。
    cmd[-1:-1] = ["-map_metadata", "0"]

    if ext in (".ts", ".m4v"):
        # copy 失败(容器不兼容源编码)→ 清理占位,降级转码 libx264 再试。
        ok, _, _ = run_ffmpeg(cmd, duration, "转换中", file_name=fname, output_path=output_path)
        if not ok:
            cleanup_if_empty(output_path)
            cmd = [FFMPEG, "-y", "-i", input_path,
                   "-c:v", "libx264", "-preset", preset_map.get(preset, "medium"),
                   "-crf", crf or "23", "-c:a", "aac", "-map_metadata", "0", output_path]
            progress(0, message="copy 封装失败,降级转码…")
            ok, err, code = run_ffmpeg(cmd, duration, "转换中(转码)", file_name=fname, output_path=output_path)
            if not ok:
                cleanup_if_empty(output_path)
                msg = "ffmpeg 转换失败。请检查输入文件是否损坏、所选格式是否支持、磁盘空间是否充足。"
                if err:
                    msg += f" ｜ 详情: {err} (ffmpeg 退出码 {code})"
                error("FFMPEG_ERROR", msg)
                return
    else:
        ok = run_with_progress(cmd, duration, "转换中", file_name=fname, output_path=output_path)
        if ok is None:
            return
    progress(100, message="转换完成", file_name=fname, output_path=output_path)
    result({
        "category": "video",
        "input": input_path,
        "output": output_path,
        "size": os.path.getsize(output_path) if os.path.exists(output_path) else 0,
    })


# ---------------------------------------------------------------- 音频转换 / 提取
def build_audio_cmd(input_path, output_path, audio_bitrate=None):
    """构造"提取/转换音频"的 ffmpeg 命令。

    统一走「解码源音轨 → 重编码为目标格式」:源音轨无论内置什么格式
    (AAC/MP3/Opus/AC3/FLAC/WMA…),ffmpeg 都能解码,因此该命令同时
    覆盖「音频格式转换」与「从视频提取音频」两个场景。-vn 丢弃视频流。
    """
    ext = os.path.splitext(output_path)[1].lower()
    codec_map = {
        ".mp3": "libmp3lame", ".m4a": "aac", ".wav": "pcm_s16le",
        ".flac": "flac", ".ogg": "libvorbis", ".aac": "aac",
        ".wma": "wmav2", ".aiff": "pcm_s16be", ".opus": "libopus",
        ".amr": "libopencore_amrnb",
        # m4b/mka 在输入白名单内(m4b=有声书/m4a 变体,mka=Matroska 音频):
        # 输出侧同样需要编码映射,缺省会回退 libmp3lame 把 mp3 写进 m4b/mka
        # 容器导致 ffmpeg 报错或生成坏文件(C-6)。
        ".m4b": "aac", ".mka": "aac",
    }
    codec = codec_map.get(ext, "libmp3lame")
    if ext == ".ogg" and not has_encoder("libvorbis"):
        # libvorbis 缺失时回退 libopus(ogg 容器原生支持 opus;
        # 原生 vorbis 编码器在 ffmpeg 8.x 实测不可用,不能作为回退)
        codec = "libopus"

    cmd = [FFMPEG, "-y", "-i", input_path, "-vn", "-acodec", codec]
    if ext in (".mp3", ".m4a"):
        cmd += ["-b:a", audio_bitrate or "192k"]
    elif ext == ".wav":
        # 不强制 -ar:wav 应保留源采样率(48k/96k 无损输出,降采样违背无损语义)
        pass
    elif ext == ".ogg":
        # opus 编码器用 -b:a,vorbis 用 -q:a,按实际选中的 codec 给参数
        cmd += ["-b:a", audio_bitrate or "128k"] if codec == "libopus" else ["-q:a", "4"]
    elif ext == ".opus":
        cmd += ["-b:a", audio_bitrate or "128k"]
    cmd.append(output_path)
    # 保留源元数据(标题/艺术家等);位置须在输出文件参数之前(最后元素前插入)
    cmd[-1:-1] = ["-map_metadata", "0"]
    return cmd


def convert_audio(input_path, output_path, audio_bitrate=None):
    output_path = resolve_output(input_path, output_path)
    ensure_output_dir(output_path)
    duration = probe_duration(input_path)
    fname = os.path.basename(output_path)
    progress(0, message=f"开始转换音频 {os.path.basename(input_path)}...",
             file_name=fname, output_path=output_path)

    # 外部库编码器缺失防护(与视频/图片分支对称;ogg 的 libvorbis 缺失在
    # build_audio_cmd 内已回退 libopus,不在此列)
    ext = os.path.splitext(output_path)[1].lower()
    need_encoder = {".amr": "libopencore_amrnb", ".wma": "wmav2"}.get(ext)
    if need_encoder and not has_encoder(need_encoder):
        cleanup_if_empty(output_path)
        error("ENCODER_MISSING",
              f"当前 ffmpeg 缺少 {need_encoder} 编码器,无法转 {ext.lstrip('.')}。可用: mp3/m4a/wav/flac。{ENCODER_SELF_HELP}")
        return

    cmd = build_audio_cmd(input_path, output_path, audio_bitrate)

    ok = run_with_progress(cmd, duration, "转换中", file_name=fname, output_path=output_path)
    if ok is None:
        return
    progress(100, message="转换完成", file_name=fname, output_path=output_path)
    result({
        "category": "audio",
        "input": input_path,
        "output": output_path,
        "size": os.path.getsize(output_path) if os.path.exists(output_path) else 0,
    })


# ---------------------------------------------------------------- 原样提取(无损复制)
# 源音轨编码 → 输出扩展名映射(容器需能无损封装该编码)。
# 「原音频」提取 = ffprobe 探测源音轨 → 选容器 → -c:a copy,零转码零损耗。
AUDIO_CODEC_EXT = {
    "aac": "m4a", "alac": "m4a", "mp3": "mp3", "opus": "opus", "flac": "flac",
    "vorbis": "ogg", "pcm_s16le": "wav", "pcm_s24le": "wav", "pcm_f32le": "wav",
    "ac3": "ac3", "eac3": "eac3", "wmav2": "wma", "aiff": "aiff",
}


def audio_copy_ext(codec):
    """源音轨编码 → 可无损封装的容器扩展名;未知编码(dts/truehd/mlp/pcm_u8 等)返回 None。

    未知编码没有可无损封装的容器 → 调用方降级:先按 wav 尝试 -c:a copy(大概率失败,
    因为 wav 只接受 PCM),失败再重编码 mp3。绝不能对 None 直接拼接路径(曾导致 TypeError 崩溃)。"""
    return AUDIO_CODEC_EXT.get(codec)


def probe_audio_codec(path):
    """ffprobe 探测首条音频流的编码器名;无音轨/探测失败返回 None。"""
    try:
        proc = subprocess.run(
            [FFPROBE, "-v", "error", "-select_streams", "a:0",
             "-show_entries", "stream=codec_name", "-of", "csv=p=0", path],
            capture_output=True, text=True, timeout=15,
        )
        codec = proc.stdout.strip().splitlines()[0] if proc.stdout.strip() else ""
        return codec or None
    except Exception:
        return None


def extract_audio_copy(input_path, output_path):
    """原样提取音轨(无损复制):UI 输出路径以 .copy 结尾(占位),这里探测
    源音轨编码后修正为真实扩展名,`-c:a copy` 快速封装,零转码零损耗。
    源无音轨 → 明确报错;copy 失败(容器不支持该编码)→ 回退重编码 mp3。"""
    codec = probe_audio_codec(input_path)
    if not codec:
        error("NO_AUDIO_STREAM", "未检测到音轨,无法提取音频。源视频可能没有音频流")
        return

    base = os.path.splitext(output_path)[0]
    fmt = audio_copy_ext(codec) or "wav"  # 未知编码:按 wav 尝试 copy,失败走下方降级 mp3
    real_output = _reserve_path(base + "." + fmt)
    ensure_output_dir(real_output)
    fname = os.path.basename(real_output)
    progress(0, message=f"开始提取音频 {os.path.basename(input_path)} (原样 {fmt})...",
             file_name=fname, output_path=real_output)

    duration = probe_duration(input_path)
    cmd = [FFMPEG, "-y", "-i", input_path, "-vn", "-acodec", "copy",
           "-map_metadata", "0", real_output]
    ok, err, code = run_ffmpeg(cmd, duration, "提取中", file_name=fname, output_path=real_output)
    if not ok:
        # 容器不支持该编码(copy 失败)→ 降级重编码 mp3。
        # 降级前删除首次失败的产物(可能 >0 字节的半成品):降级成功后旧文件
        # 残留会让用户以为生成了两份/看到损坏文件(C-3)。
        _remove_output(real_output)
        progress(0, message="无损封装失败,降级重编码 mp3…")
        fallback = _reserve_path(base + ".mp3")
        cmd = [FFMPEG, "-y", "-i", input_path, "-vn", "-acodec", "libmp3lame",
               "-b:a", "192k", "-map_metadata", "0", fallback]
        ok2, err2, code2 = run_ffmpeg(cmd, duration, "转换中(降级)", file_name=os.path.basename(fallback), output_path=fallback)
        if not ok2:
            cleanup_if_empty(fallback)
            msg = "音频提取失败。请检查源视频音轨是否损坏。"
            if err2:
                msg += f" ｜ 详情: {err2} (ffmpeg 退出码 {code2})"
            error("FFMPEG_ERROR", msg)
            return
        progress(100, message="转换完成（已降级为 mp3）", file_name=os.path.basename(fallback), output_path=fallback)
        result({"category": "audio", "input": input_path, "output": fallback,
                "size": os.path.getsize(fallback), "fallback": "mp3"})
        return
    progress(100, message="转换完成", file_name=fname, output_path=real_output)
    result({"category": "audio", "input": input_path, "output": real_output,
            "size": os.path.getsize(real_output), "codec": codec})


@lru_cache(maxsize=None)
def has_encoder(name):
    """检测 ffmpeg 是否有指定编码器(进程内缓存,批量转换不重复探测)。"""
    try:
        proc = subprocess.run([FFMPEG, "-hide_banner", "-encoders"],
                              capture_output=True, text=True, timeout=10)
        return f" {name} " in f" {proc.stdout} "
    except Exception:
        return False


@lru_cache(maxsize=None)
def has_muxer(name):
    """检测 ffmpeg 是否有指定封装器(muxer)。

    编码器存在 ≠ 能输出该格式:如 macOS homebrew 构建有 libx265 但无 heif muxer,
    转 HEIC 运行时才报 "Unable to choose an output format"。heic/webm 等格式
    需要「编码器 + 封装器」双组件,probe 提前检测供 UI 置灰。"""
    try:
        proc = subprocess.run([FFMPEG, "-hide_banner", "-muxers"],
                              capture_output=True, text=True, timeout=10)
        return f" {name} " in f" {proc.stdout} "
    except Exception:
        return False


# 编码器/封装器缺失时的自助路径引导(追加到所有 ENCODER_MISSING 报错):
# 依赖体系「系统 PATH 优先」——安装含所需编码器的系统 ffmpeg 后自动识别。
# 注意:macOS 常用构建(brew/evermeet)均不含 libwebp/HEIF,装系统 ffmpeg 也解不了
# webp/heic,故不写具体命令(避免误导),缺失组件在报错文案/tooltip 中已列出。
ENCODER_SELF_HELP = "可安装含所需编码器的系统 ffmpeg 后自动解锁,或换用可用格式"


# ---------------------------------------------------------------- 图片转换
# 质量档位统一为语义值 high/medium/low(UI 只暴露语义,不暴露编码器原生数值):
# - JPG 的 -q:v 是量化标度(1~31,越小越好)——UI 曾直接透传 90/75/60 被 ffmpeg
#   clamp 到最差质量(曾实测三者输出完全一致),必须映射
# - webp 的 -quality(0~100,越大越好) 与 jpg 方向相反——各格式各自映射,不做伪统一值
# - avif/heic 用 -crf(越小越好),由固定值改为可调档位
JPG_Q_MAP = {"high": "2", "medium": "5", "low": "8"}
WEBP_Q_MAP = {"high": "90", "medium": "75", "low": "60"}
AVIF_CRF_MAP = {"high": "26", "medium": "30", "low": "36"}
HEIC_CRF_MAP = {"high": "24", "medium": "28", "low": "33"}


def convert_image(input_path, output_path, quality="high"):
    output_path = resolve_output(input_path, output_path)
    ensure_output_dir(output_path)
    progress(0, message=f"开始转换图片 {os.path.basename(input_path)}...",
             file_name=os.path.basename(output_path), output_path=output_path)

    ext = os.path.splitext(output_path)[1].lower()
    cmd = [FFMPEG, "-y", "-i", input_path]
    if ext in (".jpg", ".jpeg"):
        cmd += ["-q:v", JPG_Q_MAP.get(quality, JPG_Q_MAP["medium"]), "-qmin", "1"]
    elif ext == ".webp":
        if not has_encoder("libwebp"):
            cleanup_if_empty(output_path)
            error("ENCODER_MISSING", f"当前 ffmpeg 缺少 libwebp 编码器,无法转 WebP。可用: jpg/png/heic。{ENCODER_SELF_HELP}")
            return
        cmd += ["-quality", WEBP_Q_MAP.get(quality, WEBP_Q_MAP["medium"])]
    elif ext == ".png":
        cmd += ["-compression_level", "6"]
    elif ext == ".heic":
        if not has_encoder("libx265") or not has_muxer("heif"):
            cleanup_if_empty(output_path)
            error("ENCODER_MISSING", f"当前 ffmpeg 缺少 libx265 编码器或 HEIF 封装器,无法转 HEIC。可用: jpg/png/webp。{ENCODER_SELF_HELP}")
            return
        cmd += ["-c:v", "libx265", "-crf", HEIC_CRF_MAP.get(quality, HEIC_CRF_MAP["medium"]), "-tag:v", "hvc1"]
    elif ext == ".avif":
        # AVIF = AV1 容器:libsvtav1 快、libaom-av1 质量好;都缺则明确提示。
        # 注意:不用 -still-picture(ffmpeg 8.x 的 libsvtav1 已不暴露该选项,会报错)。
        if has_encoder("libsvtav1"):
            cmd += ["-c:v", "libsvtav1", "-crf", AVIF_CRF_MAP.get(quality, AVIF_CRF_MAP["medium"]), "-b:v", "0"]
        elif has_encoder("libaom-av1"):
            cmd += ["-c:v", "libaom-av1", "-crf", AVIF_CRF_MAP.get(quality, AVIF_CRF_MAP["medium"]), "-b:v", "0"]
        else:
            cleanup_if_empty(output_path)
            error("ENCODER_MISSING", f"当前 ffmpeg 缺少 AV1 编码器(libsvtav1/libaom),无法转 AVIF。可用: jpg/png/webp。{ENCODER_SELF_HELP}")
            return
    cmd.append(output_path)

    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
    except FileNotFoundError:
        # 占位文件残留会让用户误以为输出已生成(与 convert_video 各失败分支一致)
        cleanup_if_empty(output_path)
        error("FFMPEG_MISSING", "未找到 ffmpeg,请先安装共享依赖")
        return
    except subprocess.TimeoutExpired:
        cleanup_if_empty(output_path)
        error("TIMEOUT", "图片转换超时(180s)。可尝试更换更快的预设或减小输入文件")
        return

    if proc.returncode != 0:
        cleanup_if_empty(output_path)
        err = (proc.stderr or "").strip()[-400:]
        msg = "图片转换失败。请检查输入图片是否损坏、所选格式是否支持。"
        if err:
            msg += f" ｜ 详情: {err} (ffmpeg 退出码 {proc.returncode})"
        else:
            msg += f" (ffmpeg 退出码 {proc.returncode})"
        error("FFMPEG_ERROR", msg)
        return

    progress(100, message="转换完成",
             file_name=os.path.basename(output_path), output_path=output_path)
    result({
        "category": "image",
        "input": input_path,
        "output": output_path,
        "size": os.path.getsize(output_path) if os.path.exists(output_path) else 0,
    })


# ---------------------------------------------------------------- 探测
def probe():
    """探测依赖与编码器能力(UI 进页面调用,即时执行不进任务中心):
    has_ffmpeg 供依赖缺失提示;encoders 供 UI 禁用当前构建不可用的格式。
    ffmpeg 缺失时 has_encoder 内部捕获异常返回 False,has_ffmpeg=False。"""
    encoders = {}
    for enc in ("libx264", "libx265", "libvpx-vp9", "libopus", "libmp3lame",
                "libvorbis", "libwebp", "libsvtav1", "libaom-av1", "wmav2",
                "libopencore_amrnb", "flac", "aac"):
        encoders[enc] = has_encoder(enc)
    # 封装器能力(编码器存在不代表能输出该容器,如 macOS 构建有 libx265 无 heif)
    muxers = {"heif": has_muxer("heif")}
    try:
        has_ff = subprocess.run([FFMPEG, "-version"],
                                capture_output=True, timeout=5).returncode == 0
    except Exception:
        has_ff = False
    result({
        "has_ffmpeg": has_ff,
        # ffmpeg 来源:system=系统 PATH 优先(用户装的,可能是全功能构建);
        # cached=共享缓存下载的内置精简构建(缺 GPL 编码器,置灰时引导装系统 ffmpeg)。
        "ffmpeg_source": "system" if FFMPEG == "ffmpeg" else "cached",
        "video_formats": ["mp4", "mkv", "mov", "webm", "avi", "gif", "m4v", "ts", "mpg", "flv"],
        "extractable_audio": ["copy", "mp3", "m4a", "wav", "flac"],
        "audio_formats": ["mp3", "m4a", "aac", "wav", "flac", "ogg", "opus", "wma", "aiff"],
        "image_formats": ["jpg", "png", "webp", "avif", "gif", "heic", "bmp", "tiff"],
        "encoders": encoders,
        "muxers": muxers,
    })


def main():
    argv = sys.argv[1:]
    if not argv:
        result({"usage": "convert <probe|convert> --input FILE --output FILE [--preset fast|medium|slow] [--quality high|medium|low] [--audio-bitrate 128k] [--gif-fps 10] [--gif-width 480]"})
        return
    cmd = argv[0]
    args = parse_args(argv[1:])

    try:
        if cmd == "probe":
            probe()
        elif cmd == "convert":
            if not args.get("input") or not args.get("output"):
                error("MISSING_ARGS", "需要 --input 和 --output 参数")
                return
            inp = args["input"]
            if not os.path.exists(inp):
                error("INPUT_MISSING", f"输入文件不存在: {inp}")
                return
            # 按输出扩展名优先决定转换意图:
            # .copy → 原样提取音轨(无损复制);.mp3/.m4a/.wav → 重编码提取;
            # 音频/图片扩展名 → 对应转换;其余 → 视频转换。
            out_ext = os.path.splitext(args["output"])[1].lower()
            if out_ext == ".copy":
                extract_audio_copy(inp, args["output"])
            elif out_ext in AUDIO_EXTS:
                convert_audio(inp, args["output"], args.get("audio_bitrate"))
            elif out_ext in IMAGE_EXTS:
                # quality 空串(manifest 占位符未提供)容错回退 high
                convert_image(inp, args["output"], args.get("quality") or "high")
            else:
                # 否则按输入类别走视频转换;codec 仅影响 mp4(h264 默认 / hevc)。
                # 提取音频是独立操作:UI 输出 .mp3/.m4a/.wav/.copy 时走上方分支。
                convert_video(inp, args["output"], args.get("preset", "medium"),
                              args.get("crf"), args.get("audio_bitrate"),
                              args.get("codec") or "h264",
                              args.get("gif_fps") or "10", args.get("gif_width") or "480")
        else:
            error("UNKNOWN_CMD", f"未知命令: {cmd}")
    except Exception as e:
        error("PLUGIN_ERROR", str(e))
        sys.exit(1)


if __name__ == "__main__":
    main()
