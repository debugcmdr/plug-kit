#!/usr/bin/env python3
"""plugkit-convert - 视频格式转换插件(基于 ffmpeg)"""
import json
import os
import re
import subprocess
import sys


def progress(percent, message=None):
    line = {"type": "progress", "percent": percent}
    if message:
        line["message"] = message
    print(json.dumps(line, ensure_ascii=False), flush=True)


def result(data):
    print(json.dumps({"type": "result", "success": True, "data": data}, ensure_ascii=False), flush=True)


def error(code, message):
    print(json.dumps({"type": "error", "code": code, "message": message}, ensure_ascii=False), flush=True)


def dep(name):
    key = f"PLUGKIT_{name.upper().replace('-', '_')}"
    if key in os.environ:
        return os.environ[key]
    return name


FFMPEG = dep("ffmpeg")


def parse_args(argv):
    args = {}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--"):
            key = a[2:].split("=")[0]
            if "=" in a:
                args[key] = a.split("=", 1)[1]
            elif i + 1 < len(argv) and not argv[i + 1].startswith("--"):
                args[key] = argv[i + 1]
                i += 1
            else:
                args[key] = True
        i += 1
    return args


def probe_duration(path):
    """用 ffprobe 获取时长(秒),用于进度计算。"""
    try:
        proc = subprocess.run(
            [dep("ffprobe"), "-v", "error", "-show_entries", "format=duration",
             "-of", "json", path],
            capture_output=True, text=True, timeout=15,
        )
        d = json.loads(proc.stdout)
        return float(d.get("format", {}).get("duration", 0) or 0)
    except Exception:
        return 0


def convert(input_path, output_path, preset="fast", audio_bitrate=None):
    """转换视频格式。"""
    if not os.path.exists(input_path):
        error("INPUT_MISSING", f"输入文件不存在: {input_path}")
        return

    duration = probe_duration(input_path)
    progress(0, message=f"开始转换 {os.path.basename(input_path)}...")

    cmd = [FFMPEG, "-y", "-i", input_path]
    # 预设:fast/medium/slow 对应 libx264 preset
    preset_map = {"fast": "fast", "medium": "medium", "slow": "slow"}
    if output_path.endswith((".mp4", ".mkv", ".mov")):
        cmd += ["-c:v", "libx264", "-preset", preset_map.get(preset, "medium")]
        if audio_bitrate:
            cmd += ["-c:a", "aac", "-b:a", audio_bitrate]
        else:
            cmd += ["-c:a", "aac"]
    elif output_path.endswith(".webm"):
        cmd += ["-c:v", "libvpx-vp9", "-c:a", "libopus"]
    else:
        cmd += ["-c:v", "copy", "-c:a", "copy"]
    cmd.append(output_path)

    try:
        proc = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1,
        )
    except FileNotFoundError:
        error("FFMPEG_MISSING", "未找到 ffmpeg,请先在主程序安装共享依赖")
        return

    # 解析 ffmpeg 的 time= 进度
    last_pct = 0
    for line in proc.stdout:
        m = re.search(r"time=(\d+):(\d+):([\d.]+)", line)
        if m and duration > 0:
            elapsed = int(m.group(1)) * 3600 + int(m.group(2)) * 60 + float(m.group(3))
            pct = min(99.0, (elapsed / duration) * 100)
            if pct - last_pct >= 1:
                progress(pct, message=f"转换中 {pct:.0f}%")
                last_pct = pct
        elif "error" in line.lower() and "duration" not in line.lower():
            pass  # 不把 ffmpeg 普通 stderr 当错误

    proc.wait()
    if proc.returncode != 0:
        error("FFMPEG_ERROR", f"ffmpeg 转换失败(退出码 {proc.returncode})")
        return

    progress(100, message="转换完成")
    result({
        "input": input_path,
        "output": output_path,
        "size": os.path.getsize(output_path) if os.path.exists(output_path) else 0,
    })


def main():
    argv = sys.argv[1:]
    if not argv:
        result({"usage": "convert.py convert --input FILE --output FILE [--preset fast|medium|slow] [--audio-bitrate 128k]"})
        return
    cmd = argv[0]
    args = parse_args(argv[1:])
    try:
        if cmd == "convert":
            if not args.get("input") or not args.get("output"):
                error("MISSING_ARGS", "需要 --input 和 --output 参数")
                return
            convert(args["input"], args["output"], args.get("preset", "fast"), args.get("audio_bitrate"))
        else:
            error("UNKNOWN_CMD", f"未知命令: {cmd}")
    except Exception as e:
        error("PLUGIN_ERROR", str(e))
        sys.exit(1)


if __name__ == "__main__":
    main()
