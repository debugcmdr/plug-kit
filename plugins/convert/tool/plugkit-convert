#!/usr/bin/env python3
"""plugkit-convert - 格式转换工具(基于 ffmpeg)

三大类转换:
- 视频: mp4 / mkv / mov / webm / avi / gif(视频转 gif)
- 音频: mp3 / m4a / wav / flac / ogg
- 图片: jpg / png / webp / heic
"""
import json
import os
import re
import subprocess
import sys
import time


def progress(percent, message=None, speed=None, eta=None, file_name=None, output_path=None):
    line = {"type": "progress", "percent": percent}
    if message:
        line["message"] = message
    if speed:
        line["speed"] = speed
    if eta:
        line["eta"] = eta
    if file_name:
        line["file_name"] = file_name
    if output_path:
        line["output_path"] = output_path
    print(json.dumps(line, ensure_ascii=False), flush=True)


def format_hms(seconds):
    """秒数 → HH:MM:SS / MM:SS(用于 ETA 倒计时)。"""
    seconds = int(round(seconds))
    if seconds < 0:
        seconds = 0
    h = seconds // 3600
    m = (seconds % 3600) // 60
    s = seconds % 60
    if h > 0:
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m:02d}:{s:02d}"


def result(data):
    print(json.dumps({"type": "result", "success": True, "data": data}, ensure_ascii=False), flush=True)


def error(code, message):
    print(json.dumps({"type": "error", "code": code, "message": message}, ensure_ascii=False), flush=True)


def dep(name):
    key = f"PLUGKIT_{name.upper().replace('-', '_')}"
    if key in os.environ:
        return os.environ[key]
    return name


FFMPEG = dep("ffmpeg")
FFPROBE = dep("ffprobe")

VIDEO_EXTS = {".mp4", ".mkv", ".mov", ".webm", ".avi", ".m4v", ".ts", ".ogv", ".3gp", ".flv", ".wmv", ".mpg", ".mpeg", ".rmvb"}
AUDIO_EXTS = {".mp3", ".m4a", ".wav", ".flac", ".ogg", ".aac", ".wma", ".aiff"}
IMAGE_EXTS = {".jpg", ".jpeg", ".png", ".webp", ".heic", ".heif", ".bmp", ".gif", ".tiff"}


def parse_args(argv):
    args = {}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--"):
            key = a[2:].split("=")[0].replace("-", "_")
            if "=" in a:
                args[key] = a.split("=", 1)[1]
            elif i + 1 < len(argv) and not argv[i + 1].startswith("--"):
                args[key] = argv[i + 1]
                i += 1
            else:
                args[key] = True
        i += 1
    return args


def detect_category(path):
    """按扩展名判断输入媒体类别。"""
    ext = os.path.splitext(path)[1].lower()
    if ext in VIDEO_EXTS:
        return "video"
    if ext in AUDIO_EXTS:
        return "audio"
    if ext in IMAGE_EXTS:
        return "image"
    return "unknown"


def probe_duration(path):
    """ffprobe 获取时长(秒),用于进度计算。"""
    try:
        proc = subprocess.run(
            [FFPROBE, "-v", "error", "-show_entries", "format=duration",
             "-of", "json", path],
            capture_output=True, text=True, timeout=15,
        )
        d = json.loads(proc.stdout)
        return float(d.get("format", {}).get("duration", 0) or 0)
    except Exception:
        return 0


def run_with_progress(cmd, duration, label, file_name=None, output_path=None):
    """执行 ffmpeg,流式解析 time=/speed= 进度,并估算剩余时间(ETA)。
    file_name/output_path 随进度上报,任务中心据此展示转换文件名与"打开输出文件夹"入口。"""
    try:
        proc = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1,
        )
    except FileNotFoundError:
        error("FFMPEG_MISSING", "未找到 ffmpeg,请先安装共享依赖")
        return None

    last_pct = -1.0
    last_report = time.time()
    tail = []  # 保留 stderr/stdout 末尾(ffmpeg 合并输出),失败时作为诊断详情
    for line in proc.stdout:
        tail.append(line)
        if len(tail) > 8:
            tail.pop(0)
        m = re.search(r"time=(\d+):(\d+):([\d.]+)", line)
        s = re.search(r"speed=\s*([\d.]+)x", line)
        speed = float(s.group(1)) if s else None
        if m and duration > 0:
            elapsed = int(m.group(1)) * 3600 + int(m.group(2)) * 60 + float(m.group(3))
            pct = min(99.0, (elapsed / duration) * 100)
            # 剩余时长估算:剩余媒体时长 ÷ 当前处理速度(无速度则按实时计)。
            remaining = max(0.0, duration - elapsed)
            eta = remaining / speed if (speed and speed > 0) else remaining
            eta_str = format_hms(eta)
            speed_str = f"{speed:.2f}x" if speed else None
            now = time.time()
            # 1% 变化 或 每 2 秒 至少上报一次,保证 ETA 平滑刷新。
            if pct - last_pct >= 1 or (now - last_report) >= 2.0:
                progress(pct, message=label, speed=speed_str, eta=eta_str,
                         file_name=file_name, output_path=output_path)
                last_pct = pct
                last_report = now

    proc.wait()
    if proc.returncode != 0:
        err = "".join(tail).strip()[-400:]
        msg = "ffmpeg 转换失败。请检查输入文件是否损坏、所选格式是否支持、磁盘空间是否充足。"
        if err:
            msg += f" ｜ 详情: {err} (ffmpeg 退出码 {proc.returncode})"
        else:
            msg += f" (ffmpeg 退出码 {proc.returncode})"
        error("FFMPEG_ERROR", msg)
        return None
    return True


# ---------------------------------------------------------------- 输出路径安全化
def resolve_output(input_path, output_path):
    """安全化输出路径,杜绝数据丢失。绝不覆盖任何已存在文件。

    场景1(同路径): MP4→MP4 且输出==输入 —— ffmpeg 读改写同一文件会失败/损坏,
                  改为同目录 `_converted` 后缀。
    场景2(同名冲突): 设置了保存目录时,不同目录的同名文件(/a/1.mp4 与 /b/1.mp4)
                  都会映射到 saveDir/1.mp4,两个任务并发写同一路径,后完成的覆盖
                  先完成的 → 输出已存在时自动追加 (1)(2)… 序号。
    """
    inp = os.path.abspath(input_path)
    out = os.path.abspath(output_path)
    if out == inp:
        d = os.path.dirname(out)
        base = os.path.splitext(os.path.basename(out))[0]
        ext = os.path.splitext(out)[1]
        return _unique_path(os.path.join(d, f"{base}_converted{ext}"))
    if os.path.exists(out):
        return _unique_path(out)
    return output_path


def _unique_path(path):
    """若 path 已存在,在文件名后追加 (1)、(2)… 直到不冲突。"""
    if not os.path.exists(path):
        return path
    d = os.path.dirname(os.path.abspath(path))
    base = os.path.splitext(os.path.basename(path))[0]
    ext = os.path.splitext(path)[1]
    i = 1
    while True:
        cand = os.path.join(d, f"{base} ({i}){ext}")
        if not os.path.exists(cand):
            return cand
        i += 1


def ensure_output_dir(output_path):
    """确保输出目录存在(用户选择的保存目录被删除时不会让 ffmpeg 直接失败)。"""
    d = os.path.dirname(os.path.abspath(output_path))
    if d:
        os.makedirs(d, exist_ok=True)


# ---------------------------------------------------------------- 视频转换
def convert_video(input_path, output_path, preset="medium", crf=None, audio_bitrate=None):
    output_path = resolve_output(input_path, output_path)
    ensure_output_dir(output_path)
    duration = probe_duration(input_path)
    fname = os.path.basename(output_path)
    progress(0, message=f"开始转换视频 {os.path.basename(input_path)}...",
             file_name=fname, output_path=output_path)

    ext = os.path.splitext(output_path)[1].lower()
    preset_map = {"fast": "veryfast", "medium": "medium", "slow": "slow"}

    # 视频转 GIF
    if ext == ".gif":
        cmd = [FFMPEG, "-y", "-i", input_path,
               "-vf", "fps=10,scale=480:-1:flags=lanczos", "-loop", "0"]
        cmd.append(output_path)
    elif ext == ".webm":
        cmd = [FFMPEG, "-y", "-i", input_path,
               "-c:v", "libvpx-vp9", "-preset", preset_map.get(preset, "medium"),
               "-b:v", "0", "-crf", crf or "32", "-c:a", "libopus", "-b:a", audio_bitrate or "96k"]
        cmd.append(output_path)
    elif ext == ".mp4":
        cmd = [FFMPEG, "-y", "-i", input_path,
               "-c:v", "libx264", "-preset", preset_map.get(preset, "medium"),
               "-crf", crf or "23", "-pix_fmt", "yuv420p", "-c:a", "aac",
               "-b:a", audio_bitrate or "128k"]
        cmd.append(output_path)
    else:
        # mkv / mov / avi / m4v / ts / mpg / flv 等
        cmd = [FFMPEG, "-y", "-i", input_path]
        if ext in (".avi", ".mpg", ".mpeg", ".flv"):
            cmd += ["-c:v", "libx264", "-crf", crf or "23", "-c:a", "aac"]
        elif ext in (".ts", ".m4v"):
            cmd += ["-c:v", "copy", "-c:a", "aac"]
        else:
            cmd += ["-c:v", "libx264", "-preset", preset_map.get(preset, "medium"),
                    "-crf", crf or "23", "-c:a", "aac"]
        cmd.append(output_path)

    ok = run_with_progress(cmd, duration, "转换中", file_name=fname, output_path=output_path)
    if ok is None:
        return
    progress(100, message="转换完成", file_name=fname, output_path=output_path)
    result({
        "category": "video",
        "input": input_path,
        "output": output_path,
        "size": os.path.getsize(output_path) if os.path.exists(output_path) else 0,
    })


# ---------------------------------------------------------------- 音频转换
def convert_audio(input_path, output_path, audio_bitrate=None):
    output_path = resolve_output(input_path, output_path)
    ensure_output_dir(output_path)
    duration = probe_duration(input_path)
    fname = os.path.basename(output_path)
    progress(0, message=f"开始转换音频 {os.path.basename(input_path)}...",
             file_name=fname, output_path=output_path)

    ext = os.path.splitext(output_path)[1].lower()
    codec_map = {
        ".mp3": "libmp3lame", ".m4a": "aac", ".wav": "pcm_s16le",
        ".flac": "flac", ".ogg": "libvorbis", ".aac": "aac",
        ".wma": "wmav2", ".aiff": "pcm_s16be", ".opus": "libopus",
        ".amr": "libopencore_amrnb",
    }
    codec = codec_map.get(ext, "libmp3lame")

    cmd = [FFMPEG, "-y", "-i", input_path, "-vn", "-acodec", codec]
    if ext in (".mp3", ".m4a"):
        cmd += ["-b:a", audio_bitrate or "192k"]
    elif ext == ".wav":
        cmd += ["-ar", "44100"]
    elif ext == ".ogg":
        cmd += ["-q:a", "4"]
    elif ext == ".opus":
        cmd += ["-b:a", audio_bitrate or "128k"]
    cmd.append(output_path)

    ok = run_with_progress(cmd, duration, "转换中", file_name=fname, output_path=output_path)
    if ok is None:
        return
    progress(100, message="转换完成", file_name=fname, output_path=output_path)
    result({
        "category": "audio",
        "input": input_path,
        "output": output_path,
        "size": os.path.getsize(output_path) if os.path.exists(output_path) else 0,
    })


def has_encoder(name):
    """检测 ffmpeg 是否有指定编码器。"""
    try:
        proc = subprocess.run([FFMPEG, "-hide_banner", "-encoders"],
                              capture_output=True, text=True, timeout=10)
        return f" {name} " in f" {proc.stdout} "
    except Exception:
        return False


# ---------------------------------------------------------------- 图片转换
def convert_image(input_path, output_path, quality="90"):
    output_path = resolve_output(input_path, output_path)
    ensure_output_dir(output_path)
    progress(0, message=f"开始转换图片 {os.path.basename(input_path)}...",
             file_name=os.path.basename(output_path), output_path=output_path)

    ext = os.path.splitext(output_path)[1].lower()
    cmd = [FFMPEG, "-y", "-i", input_path]
    if ext in (".jpg", ".jpeg"):
        cmd += ["-q:v", quality, "-qmin", "1"]
    elif ext == ".webp":
        if not has_encoder("libwebp"):
            error("ENCODER_MISSING", "当前 ffmpeg 缺少 libwebp 编码器,无法转 WebP。可用: jpg/png/heic")
            return
        cmd += ["-quality", quality]
    elif ext == ".png":
        cmd += ["-compression_level", "6"]
    elif ext == ".heic":
        if not has_encoder("libx265"):
            error("ENCODER_MISSING", "当前 ffmpeg 缺少 libx265 编码器,无法转 HEIC。可用: jpg/png/webp")
            return
        cmd += ["-c:v", "libx265", "-tag:v", "hvc1"]
    cmd.append(output_path)

    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
    except FileNotFoundError:
        error("FFMPEG_MISSING", "未找到 ffmpeg,请先安装共享依赖")
        return
    except subprocess.TimeoutExpired:
        error("TIMEOUT", "图片转换超时(180s)。可尝试更换更快的预设或减小输入文件")
        return

    if proc.returncode != 0:
        err = (proc.stderr or "").strip()[-400:]
        msg = "图片转换失败。请检查输入图片是否损坏、所选格式是否支持。"
        if err:
            msg += f" ｜ 详情: {err} (ffmpeg 退出码 {proc.returncode})"
        else:
            msg += f" (ffmpeg 退出码 {proc.returncode})"
        error("FFMPEG_ERROR", msg)
        return

    progress(100, message="转换完成",
             file_name=os.path.basename(output_path), output_path=output_path)
    result({
        "category": "image",
        "input": input_path,
        "output": output_path,
        "size": os.path.getsize(output_path) if os.path.exists(output_path) else 0,
    })


# ---------------------------------------------------------------- 探测
def probe():
    """探测输入文件类别 + 支持的目标格式列表。"""
    result({
        "video_formats": ["mp4", "mkv", "mov", "webm", "avi", "gif"],
        "audio_formats": ["mp3", "m4a", "wav", "flac", "ogg"],
        "image_formats": ["jpg", "png", "webp", "heic"],
        "has_ffmpeg": True,
    })


def main():
    argv = sys.argv[1:]
    if not argv:
        result({"usage": "convert <probe|convert> --input FILE --output FILE [--preset fast|medium|slow] [--quality 90] [--audio-bitrate 128k]"})
        return
    cmd = argv[0]
    args = parse_args(argv[1:])

    try:
        if cmd == "probe":
            probe()
        elif cmd == "convert":
            if not args.get("input") or not args.get("output"):
                error("MISSING_ARGS", "需要 --input 和 --output 参数")
                return
            inp = args["input"]
            if not os.path.exists(inp):
                error("INPUT_MISSING", f"输入文件不存在: {inp}")
                return
            # 按输出扩展名优先决定转换意图(如 .mp3 输出 → 提取音频)
            out_ext = os.path.splitext(args["output"])[1].lower()
            if out_ext in AUDIO_EXTS:
                convert_audio(inp, args["output"], args.get("audio_bitrate"))
            elif out_ext in IMAGE_EXTS:
                convert_image(inp, args["output"], args.get("quality", "90"))
            else:
                # 否则按输入类别走视频转换
                convert_video(inp, args["output"], args.get("preset", "medium"),
                              args.get("crf"), args.get("audio_bitrate"))
        else:
            error("UNKNOWN_CMD", f"未知命令: {cmd}")
    except Exception as e:
        error("PLUGIN_ERROR", str(e))
        sys.exit(1)


if __name__ == "__main__":
    main()
