{
  "id": "convert",
  "name": "格式转换",
  "version": "0.3.0",
  "description": "视频 / 音频 / 图片格式转换(基于 ffmpeg)",
  "author": "plug-kit",
  "category": "media",
  "tags": ["video", "audio", "image", "convert", "ffmpeg"],
  "platforms": ["windows-x64", "macos-arm64", "macos-x64", "linux-x64"],
  "dependencies": {
    "ffmpeg": ">=6.0",
    "ffprobe": ">=6.0"
  },
  "bridgeVersion": ">=1.0.0",
  "entry": {
    "type": "cli",
    "executable": "plugkit-convert",
    "toolDir": "tool"
  },
  "commands": {
    "probe": {
      "stdinArgs": ["probe"],
      "output": "json"
    },
    "convert": {
      "stdinArgs": ["convert", "--input", "{input}", "--output", "{output}", "--quality", "{quality}", "--audio-bitrate", "{audio_bitrate}", "--codec", "{codec}"],
      "output": "progress+json"
    }
  },
  "releaseUrl": "https://github.com/debugcmdr/plug-kit/releases/latest"
}
