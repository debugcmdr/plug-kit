#!/usr/bin/env python3
"""plugkit-download - 万能下载工具(基于 yt-dlp)

支持:视频 / 音频 / 图片 / 直播 / 字幕 五类下载 + 播放列表 + 文件导入链接。
交互:「提取资源列表 → 选择清晰度/类型/字幕 → 下载」。
"""
import csv
import json
import os
import re
import shutil
import subprocess
import sys

# ---- 协议辅助(与主程序 plugkit 协议对齐) ----
def progress(percent, speed=None, eta=None, message=None, file_name=None, output_path=None):
    line = {"type": "progress", "percent": percent}
    if speed:
        line["speed"] = speed
    if eta:
        line["eta"] = eta
    if message:
        line["message"] = message
    # 任务中心据此展示文件名与「打开输出文件夹」按钮(与 convert 插件对齐)。
    if file_name:
        line["file_name"] = file_name
    if output_path:
        line["output_path"] = output_path
    print(json.dumps(line, ensure_ascii=False), flush=True)


def result(data):
    print(json.dumps({"type": "result", "success": True, "data": data}, ensure_ascii=False), flush=True)


def error(code, message):
    print(json.dumps({"type": "error", "code": code, "message": message}, ensure_ascii=False), flush=True)


def dep(name):
    key = f"PLUGKIT_{name.upper().replace('-', '_')}"
    if key in os.environ:
        return os.environ[key]
    return name  # fallback to PATH


YTDLP = dep("yt-dlp")
FFMPEG = dep("ffmpeg")

# 分类对应的 yt-dlp 选择器
CATEGORY_VIDEO = "video"    # 视频(视频+音频)
CATEGORY_AUDIO = "audio"    # 音频(仅音频 mp3)
CATEGORY_IMAGE = "image"    # 图片(缩略图/原图)
CATEGORY_LIVE = "live"      # 直播流
CATEGORY_SUBTITLE = "subtitle"  # 字幕(手动/自动字幕轨道)

# --cookies-from-browser 支持的浏览器名
BROWSER_NAMES = {
    "chrome", "chromium", "edge", "firefox", "brave",
    "vivaldi", "opera", "safari", "whale",
}


def parse_args(argv):
    args = {}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--"):
            # 去掉前导 --,连字符转下划线(便于 args 里用 output_dir 等键)
            key = a[2:].split("=")[0].replace("-", "_")
            if "=" in a:
                args[key] = a.split("=", 1)[1]
            elif i + 1 < len(argv) and not argv[i + 1].startswith("--"):
                args[key] = argv[i + 1]
                i += 1
            else:
                args[key] = True
        i += 1
    return args


def cookies_args(cookies):
    """把 --cookies 参数转为 yt-dlp 参数。

    cookies 取值:
      - 浏览器名(chrome/edge/firefox/brave/...) → --cookies-from-browser
      - 文件路径 → --cookies <file>
      - 空/未提供 → 不加参数
    """
    if not cookies or cookies is True or str(cookies).strip() == "":
        return []
    c = str(cookies).strip()
    if c in BROWSER_NAMES:
        return ["--cookies-from-browser", c]
    if os.path.isfile(c) or c.endswith((".txt", ".cookies")):
        return ["--cookies", c]
    # 未知值按浏览器名透传(yt-dlp 会给出明确错误提示)
    return ["--cookies-from-browser", c]


def playlist_args(playlist):
    """--playlist 为真值(1/yes/true)时返回 --yes-playlist,支持下载整个播放列表/频道。"""
    if not playlist or playlist is True:
        return []
    p = str(playlist).strip().lower()
    return ["--yes-playlist"] if p in ("1", "yes", "true", "on") else []


# 常见 yt-dlp 错误 → (语义化代码, 可读原因 + 原始错误)
# 设计:精确分类,避免把"网络挂起/412 风控"误归为"需要 cookies";
# 末尾附加 yt-dlp 原始错误行(截断),方便用户自诊与排查。
def diagnose_ytdlp_error(err_lines, last_lines, code):
    """根据 yt-dlp stderr/最后行推断失败原因,返回 (code, message)。

    code 枚举: NEED_LOGIN / JS_RUNTIME_MISSING / DRM_PROTECTED / PRIVATE_VIDEO
             / MEMBERS_ONLY / AGE_RESTRICTED / GEO_BLOCKED / RATE_LIMITED_412
             / HTTP_403 / HTTP_404 / NO_FORMATS_AVAILABLE / NETWORK_ERROR
             / UNSUPPORTED_URL / FFMPEG_ERROR / UNKNOWN_ERROR
    """
    raw = " ".join((err_lines or []) + (last_lines or []))
    raw_lower = raw.lower()

    # 抓取 yt-dlp 原始错误最后一行(去 [download] 前缀),供用户自诊。
    detail = ""
    for line in reversed(last_lines or []):
        if line and not line.startswith("[download]"):
            detail = line.strip()[-200:]
            break
    suffix = f" ｜ 详情: {detail}" if detail else ""

    # 0. 浏览器 cookies 读取权限(macOS 沙盒:Safari 需「完全磁盘访问」授权)。
    #    必须放在登录态判断之前——这是 cookies 读取本身失败,比"需要登录"更具体。
    if "operation not permitted" in raw_lower or "errno 1" in raw_lower:
        return ("COOKIES_PERMISSION",
                f"无法读取浏览器 cookies(macOS 沙盒权限限制)。请打开「系统设置 → 隐私与安全性 → 完全磁盘访问权限」,"
                f"勾选 PlugKit(dev 模式为你的终端应用)后重启重试;或改用 Chrome/Edge/Firefox 等无需授权的浏览器。{suffix} (yt-dlp 退出码 {code})")

    # 1. 登录态:仅匹配明确登录指示(避免与 cookie 文件读取失败/网络错误混淆)。
    if any(k in raw_lower for k in [
        "sign in to confirm", "confirm you're not a bot", "confirm you are not a bot",
        "fresh cookies", "logged in", "login required", "use --cookies",
        "use --username", "please log in",
    ]):
        return ("NEED_LOGIN",
                f"需要登录或有效 cookies(平台反爬)。建议:在界面「登录态」选择已登录该站的浏览器,或稍后重试。{suffix} (yt-dlp 退出码 {code})")

    # 2. JS 运行时(deno 未安装)
    if "js runtime" in raw_lower or "javascript runtime" in raw_lower:
        return ("JS_RUNTIME_MISSING",
                f"该站点需要 JS 运行时(deno)才能解析,当前未安装。{suffix} (yt-dlp 退出码 {code})")

    # 3. DRM
    if "drm" in raw_lower or "widevine" in raw_lower or "encrypted and not yet" in raw_lower:
        return ("DRM_PROTECTED",
                f"该视频受 DRM 加密保护,无法下载。{suffix} (yt-dlp 退出码 {code})")

    # 4. 412 风控(优先级高于 403,避免误归为 cookies 提示)
    if "412" in raw_lower or "blocked by server" in raw_lower or "request is blocked" in raw_lower:
        return ("RATE_LIMITED_412",
                f"服务端主动拒绝(412,风控/限流)。通常过会儿可恢复,或换网络/用登录 cookies 后再试。{suffix} (yt-dlp 退出码 {code})")
    # 4.5 B 站 API 业务风控(code:-403 等):虽然 HTTP 200,但 API 业务码拒绝
    if ('"code":-403' in raw_lower or '"code":-101' in raw_lower or '"code":-352' in raw_lower
            or "访问权限不足" in raw):
        return ("API_BLOCKED",
                f"站点 API 业务风控(如 B 站 code:-403/-101 等)。通常意味着 IP 被风控或需要登录 cookies。{suffix} (yt-dlp 退出码 {code})")

    # 5. 私密/会员/年龄(细分)
    if "members only" in raw_lower:
        return ("MEMBERS_ONLY",
                f"该视频为会员专属,需要订阅会员 cookies。{suffix} (yt-dlp 退出码 {code})")
    if "age" in raw_lower and ("restrict" in raw_lower or "limit" in raw_lower):
        return ("AGE_RESTRICTED",
                f"该视频有年龄限制,需要登录相应账号。{suffix} (yt-dlp 退出码 {code})")
    if "this video is private" in raw_lower or "private video" in raw_lower or "video is private" in raw_lower:
        return ("PRIVATE_VIDEO",
                f"该视频为私密/不可访问。{suffix} (yt-dlp 退出码 {code})")

    # 6. 地区限制
    if "geo" in raw_lower or "not available in your country" in raw_lower:
        return ("GEO_BLOCKED",
                f"该视频在你的地区不可用(地区限制)。{suffix} (yt-dlp 退出码 {code})")

    # 7. 无可用格式(直播结束/格式变化)
    if any(k in raw_lower for k in [
        "requested format not available", "no video formats", "no format",
        "unable to download video", "no media could be extracted",
    ]):
        return ("NO_FORMATS_AVAILABLE",
                f"没有可用的视频/音频格式(可能是直播结束、源站格式变更或链接指向图片/字幕而非视频)。{suffix} (yt-dlp 退出码 {code})")

    # 8. 403(与 412 严格区分)
    if "http error 403" in raw_lower or "403: forbidden" in raw_lower:
        return ("HTTP_403",
                f"平台拒绝访问(403,反爬)。建议:用登录 cookies 重试,或换网络。{suffix} (yt-dlp 退出码 {code})")

    # 9. 404
    if "http error 404" in raw_lower or "404: not found" in raw_lower:
        return ("HTTP_404",
                f"资源不存在或链接失效(404)。请检查链接是否有效/已被删除。{suffix} (yt-dlp 退出码 {code})")

    # 10. 网络/超时/SSL/DNS(收紧关键字,不与 cookies 命中冲突)
    if any(k in raw_lower for k in [
        "timed out", "read timed out", "connection aborted", "connection refused",
        "connection reset", "network is unreachable", "ssl:", "certificate verify failed",
        "name resolution", "temporary failure in name resolution", "no route to host",
    ]):
        return ("NETWORK_ERROR",
                f"网络连接失败/超时/SSL/DNS 异常。请检查网络后重试,或换网络/代理。{suffix} (yt-dlp 退出码 {code})")

    # 11. 不支持的链接
    if "unsupported url" in raw_lower:
        return ("UNSUPPORTED_URL",
                f"不支持的链接或站点(yt-dlp 未内置该站解析器)。{suffix} (yt-dlp 退出码 {code})")

    # 12. ffmpeg 后处理
    if "ffmpeg" in raw_lower or "postprocessing" in raw_lower or "merging" in raw_lower:
        return ("FFMPEG_ERROR",
                f"合并/后处理失败(可能需要 ffmpeg 或磁盘空间不足)。{suffix} (yt-dlp 退出码 {code})")

    # 兜底:返回原始错误,用户可自诊
    return ("UNKNOWN_ERROR",
            f"未知错误 (yt-dlp 退出码 {code}){suffix}")


def guess_height_from_url(url):
    """从下载 URL 文件名推断清晰度(如 402946-720p.mp4 → 720)。

    部分站点(hanime1 等)未把分辨率写入结构化字段,但下载地址文件名含
    `{id}-{清晰度}p.{ext}`,此处提取用于展示与排序。提取失败返回 None。"""
    if not url:
        return None
    # 优先匹配分隔符后紧跟的数字+p(如 -720p. / _1080p/ ),避免命中 URL 里其他数字
    m = re.search(r"[-_/](\d{3,4})p", url)
    if m:
        return int(m.group(1))
    m = re.search(r"(\d{3,4})p", url)
    return int(m.group(1)) if m else None


def extract_subtitles(meta, auto=False):
    """从 yt-dlp dump-json 的 subtitles / automatic_captions 提取字幕列表。

    返回 [{lang, name, ext, auto}],每种语言取第一个可用格式。"""
    source = meta.get("automatic_captions") if auto else meta.get("subtitles")
    if not source:
        return []
    subs = []
    seen = set()
    for lang, items in source.items():
        if not items:
            continue
        for s in items:
            ext = (s.get("ext") or "vtt").lower()
            key = (lang, ext)
            if key in seen:
                continue
            seen.add(key)
            subs.append({
                "lang": lang,
                "name": s.get("name") or lang,
                "ext": ext,
                "auto": auto,
            })
    # 常见语言排前面(zh / en / ja / ko),其余按字母序
    def lang_rank(l):
        base = l.split("-")[0]
        return {"zh": 0, "en": 1, "ja": 2, "ko": 3, "ru": 4, "fr": 5, "de": 6, "es": 7}.get(base, 9)
    subs.sort(key=lambda s: (lang_rank(s["lang"]), s["lang"]))
    return subs


# ---------------------------------------------------------------- 提取信息
def info(url, cookies=""):
    """提取资源信息:标题、分类可用格式列表(清晰度/大小)、字幕列表。"""
    # -J/--dump-json 输出完整 JSON(比 --print json 更可靠)
    # 网络健壮性:抖动的网络(国内访问境外/反爬站点)下默认 20s 读超时极易失败;
    # 提升超时到 20s + 5 次重试 + 重试间隔,降低 B 站等站点间歇性挂起导致的失败率。
    cmd = [YTDLP, "--skip-download", "--no-warnings",
           "--socket-timeout", "20", "--retries", "5", "--retry-sleep", "2", "-J", url]
    cmd = cmd[:1] + cookies_args(cookies) + cmd[1:]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=150)
    except subprocess.TimeoutExpired as e:
        # 计时仅覆盖 yt-dlp 拉取元数据(解析),不含 Rust 端依赖下载阶段;
        # 此处明确告知用户已排除依赖环节,避免误判为"依赖没下好"而重复提取。
        tail = ""
        if e.stderr:
            lines = [l for l in e.stderr.strip().splitlines() if l]
            if lines:
                tail = lines[-1][-240:]
        if tail and any(k in tail.lower() for k in ("timed out", "timeout", "network")):
            reason = "网络超时/连接失败(站点可能在境外或被反爬)。依赖已就绪,可重试或换链接。"
        elif tail:
            reason = f"解析超时:{tail}"
        else:
            reason = "解析超时(yt-dlp 在 90s 内未取得元数据,可能是站点反爬或地区限制)。依赖已就绪,可重试或换链接。"
        error("TIMEOUT", f"解析超时(已排除依赖下载,仅计解析时长):{reason}")
        return
    except FileNotFoundError:
        error("YTDLP_MISSING", "未找到 yt-dlp,请先安装共享依赖")
        return
    if proc.returncode != 0:
        err = proc.stderr.strip()[-400:]
        code, msg = diagnose_ytdlp_error([err], [err], proc.returncode)
        error(code, msg)
        return
    try:
        meta = json.loads(proc.stdout)
    except (json.JSONDecodeError, ValueError):
        # 兼容末尾有空白/警告行的情形:取最后一行再试
        try:
            meta = json.loads(proc.stdout.strip().splitlines()[-1])
        except Exception:
            error("PARSE_ERROR", "无法解析 yt-dlp 输出")
            return

    # 整理视频格式列表(去重、按清晰度排序)
    formats = []
    seen = set()
    for f in meta.get("formats", []):
        fmt_id = f.get("format_id")
        if not fmt_id:
            continue
        height = f.get("height")
        ext = f.get("ext", "")
        note = f.get("format_note") or ""
        size = f.get("filesize") or f.get("filesize_approx")
        vcodec = f.get("vcodec", "none")
        acodec = f.get("acodec", "none")

        is_video = vcodec != "none"
        if is_video:
            # 站点未提供结构化清晰度(hanime1 等 height 全为 null)时,
            # 从下载 URL 推断: https://vdownload.hembed.com/402946-720p.mp4 → 720。
            display_height = height or guess_height_from_url(f.get("url") or "")
            key = (display_height, ext)
            if key in seen:
                continue
            seen.add(key)
            label = f"{display_height}p" if display_height else (note or f"格式 {fmt_id}")
            formats.append({
                "id": fmt_id, "type": "video", "label": label,
                "ext": ext, "size": size,
                "height": display_height, "note": note,
            })
    # 按清晰度降序(未知清晰度排最后)
    formats.sort(key=lambda f: f["height"] or 0, reverse=True)

    # 音频格式(取最佳音频的 ext)
    audio_ext = "m4a"
    for f in meta.get("formats", []):
        if f.get("acodec") not in (None, "none") and f.get("vcodec") in (None, "none"):
            audio_ext = f.get("ext", "m4a")
            break

    # 字幕列表(手动 + 自动)
    subtitles = extract_subtitles(meta, auto=False) + extract_subtitles(meta, auto=True)

    result({
        "title": meta.get("title"),
        "uploader": meta.get("uploader"),
        "duration": meta.get("duration"),
        "thumbnail": meta.get("thumbnail"),
        "webpage_url": meta.get("webpage_url") or meta.get("original_url"),
        "is_live": meta.get("is_live", False),
        # 播放列表/多条目:列表条数(供 UI 提示"共 N 集"与整列表下载)
        "is_playlist": bool(meta.get("playlist_count")) or meta.get("_type") == "playlist",
        "playlist_count": meta.get("playlist_count"),
        "categories": ["video", "audio", "image", "live", "subtitle"] if meta.get("is_live") else ["video", "audio", "image", "subtitle"],
        "video_formats": formats[:12],   # 最多 12 个清晰度
        "audio_ext": audio_ext,
        "best_height": max([f["height"] for f in formats if f["height"]] or [0]),
        "subtitles": subtitles[:30],     # 最多 30 条字幕(每种语言 手动+自动)
        "has_subtitles": len(subtitles) > 0,
    })


# ---------------------------------------------------------------- 下载
def _run_ytdlp(cmd, url, suffix="", out_dir=None):
    """执行 yt-dlp,流式解析进度并输出。返回 (ok, files)。
    失败时给出真实原因(cookies/JS运行时/格式/网络等),而非笼统退出码。"""
    # 网络健壮性:抖动的网络(国内访问境外/反爬站点)下默认 20s 读超时极易失败,
    # 统一注入 socket-timeout + 重试,失败率显著下降。
    cmd = cmd[:1] + ["--socket-timeout", "20", "--retries", "5", "--fragment-retries", "3", "--retry-sleep", "2"] + cmd[1:]
    base_dir = out_dir or (os.path.dirname(cmd[cmd.index("-o") + 1]) if "-o" in cmd else ".")
    os.makedirs(base_dir, exist_ok=True)
    # 一开始就把输出目录上报给任务中心:运行中即可点「打开输出文件夹」。
    progress(0, message=f"准备下载{suffix}...", output_path=base_dir)
    try:
        proc = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1, universal_newlines=True,
        )
    except FileNotFoundError:
        error("YTDLP_MISSING", "未找到 yt-dlp,请先安装共享依赖")
        return False, []
    except Exception as e:
        error("YTDLP_ERROR", str(e))
        return False, []

    dst_dir = None
    file_name = None       # 下载文件名(解析 Destination 行获得,任务中心展示)
    err_lines = []          # 收集错误上下文
    last_lines = []         # 保留最后几行(下载完成后错误常在末尾)
    for line in proc.stdout:
        line = line.strip()
        if not line:
            continue
        # 保留最近 8 行,用于失败时诊断
        last_lines.append(line)
        if len(last_lines) > 8:
            last_lines.pop(0)
        m = re.search(r"\[download\]\s+([\d.]+)%\s+of\s+~?([\d.]+)(\w+)", line)
        if m:
            pct = float(m.group(1))
            speed_m = re.search(r"at\s+([\d.]+)([KMG]iB/s)", line)
            eta_m = re.search(r"ETA\s+(\S+)", line)
            progress(
                pct,
                speed=f"{speed_m.group(1)}{speed_m.group(2)}" if speed_m else None,
                eta=eta_m.group(1) if eta_m else None,
                message=f"下载中{suffix} {pct:.0f}%",
                file_name=file_name,
                output_path=base_dir,
            )
        elif line.startswith("[download] Destination:"):
            dst = line.split("Destination:", 1)[1].strip()
            dst_dir = os.path.dirname(dst) or "."
            file_name = os.path.basename(dst)
        elif line.startswith("[download] 100%"):
            progress(100, message="下载完成", file_name=file_name, output_path=base_dir)
        elif "has already been downloaded" in line:
            progress(100, message="已存在,跳过下载", file_name=file_name, output_path=base_dir)
        elif line.startswith("ERROR") or "Error" in line or "error" in line:
            err_lines.append(line)

    proc.wait()
    if proc.returncode != 0 and proc.returncode is not None:
        code, msg = diagnose_ytdlp_error(err_lines, last_lines, proc.returncode)
        error(code, msg)
        return False, []

    # 收集输出文件:优先用已知输出目录(已存在文件被跳过时不会出现 Destination: 行)
    files = []
    collect_dir = out_dir or dst_dir
    if collect_dir and os.path.isdir(collect_dir):
        files = sorted(os.listdir(collect_dir))
    return True, files


def download(url, category, quality, output_dir, extra="", cookies="", playlist=""):
    """按分类下载。quality: best / 1080 / 720 / ... ;extra: 直播时长/字幕语言;cookies: 浏览器名或文件;playlist: 是否整列表。"""
    os.makedirs(output_dir, exist_ok=True)
    pattern = os.path.join(output_dir, "%(title)s.%(ext)s")
    base_cookies = cookies_args(cookies)

    if category == CATEGORY_AUDIO:
        # 音频:提取 mp3
        cmd = [YTDLP, "--newline", "-x", "--audio-format", "mp3", "--audio-quality", "0",
               "-o", pattern]
        if quality and quality != "best":
            cmd += ["-f", f"bestaudio[abr<={quality}]/bestaudio/best"]
        cmd += playlist_args(playlist) + base_cookies + [url]
        ok, files = _run_ytdlp(cmd, url, suffix=" 提取音频", out_dir=output_dir)
        if ok:
            result({"output_dir": output_dir, "files": files, "category": category})

    elif category == CATEGORY_IMAGE:
        # 图片:下载封面/最高质量图片
        cmd = [YTDLP, "--newline", "--skip-download", "--write-thumbnail",
               "--convert-thumbnails", "jpg", "-o", pattern]
        cmd += playlist_args(playlist) + base_cookies + [url]
        ok, files = _run_ytdlp(cmd, url, suffix=" 图片", out_dir=output_dir)
        if ok:
            result({"output_dir": output_dir, "files": files, "category": category})

    elif category == CATEGORY_LIVE:
        # 直播:实时录制(可带时长限制 extra=Nm)
        cmd = [YTDLP, "--newline", "-f", "best", "-o", pattern]
        if extra:
            cmd += ["--wait-for-video", "5"]
            cmd += ["--live-from-start"] if extra == "from_start" else []
        cmd += base_cookies + [url]
        ok, files = _run_ytdlp(cmd, url, suffix=" 直播", out_dir=output_dir)
        if ok:
            result({"output_dir": output_dir, "files": files, "category": category})

    elif category == CATEGORY_SUBTITLE:
        # 字幕:单独下载字幕轨道(不下载视频)。
        # extra 语言选择:""=手动字幕全部 / "auto"=手动+自动全部 / "zh-Hans,en"=指定语言(可含 auto)。
        langs = (extra or "all").strip() or "all"
        cmd = [YTDLP, "--newline", "--skip-download",
               "--write-subs", "--sub-format", "srt/best",
               "--sub-langs", langs, "-o", pattern]
        if langs == "all" or "auto" in langs.lower():
            # all 或显式含 auto 时同时写自动字幕
            cmd.append("--write-auto-subs")
        cmd += playlist_args(playlist) + base_cookies + [url]
        ok, files = _run_ytdlp(cmd, url, suffix=" 字幕", out_dir=output_dir)
        if ok:
            result({"output_dir": output_dir, "files": files, "category": category})

    else:
        # 视频:按清晰度选择。quality 可能是 "best" / "2160p" / "未知清晰度" 等标签。
        if quality and quality != "best":
            h = re.sub(r"\D", "", quality)
            if h and int(h) > 0:
                # 有效高度 → 选对应清晰度
                fmt = f"bestvideo[height<={h}]+bestaudio/best[height<={h}]/best"
            else:
                # 无法解析高度(如"未知清晰度"/纯字母)→ 回退 best,避免无效 selector
                log_warn = "清晰度无法识别,使用最佳画质"
                progress(5, message=log_warn)
                fmt = "bestvideo+bestaudio/best"
        else:
            fmt = "bestvideo+bestaudio/best"
        cmd = [YTDLP, "--newline", "-f", fmt, "--merge-output-format", "mp4", "-o", pattern]
        cmd += playlist_args(playlist) + base_cookies + [url]
        ok, files = _run_ytdlp(cmd, url, suffix=f" {quality or '最佳'}", out_dir=output_dir)
        if ok:
            result({"output_dir": output_dir, "files": files, "category": category})


# ---------------------------------------------------------------- 文件导入链接
def looks_like_url(s):
    """粗略判断是否为可下载链接(http/https 开头)。"""
    s = (s or "").strip()
    return s.startswith(("http://", "https://")) and len(s) > 10


def import_file(path):
    """从文件导入下载链接,返回 {links: 去重后的链接列表}。

    支持:txt(每行一个)、csv、xlsx/xls(优先 url/链接列,否则取首个疑似 url 的单元格)。
    解析是插件业务(外壳只提供文件选择对话框),供 UI「导入文件」按钮使用。
    """
    if not path or not os.path.isfile(path):
        error("FILE_NOT_FOUND", f"文件不存在: {path}")
        return
    ext = os.path.splitext(path)[1].lower()
    links = []
    try:
        if ext == ".txt":
            with open(path, "r", encoding="utf-8-sig", errors="replace") as f:
                for line in f:
                    s = line.strip()
                    if looks_like_url(s):
                        links.append(s)
        elif ext == ".csv":
            with open(path, "r", encoding="utf-8-sig", errors="replace") as f:
                rows = list(csv.reader(f))
            if rows:
                header = [c.lower().strip() for c in rows[0]]
                url_col = next((i for i, c in enumerate(header)
                                if c in ("url", "link", "链接", "网址", "视频链接", "download url")), None)
                for row in rows[1:]:
                    if url_col is not None and url_col < len(row):
                        if looks_like_url(row[url_col]):
                            links.append(row[url_col].strip())
                    else:
                        for cell in row:
                            if looks_like_url(cell):
                                links.append(cell.strip())
                                break
        elif ext in (".xlsx", ".xls"):
            try:
                import openpyxl
            except ImportError:
                error("DEP_MISSING", "解析 xlsx/xls 需要 openpyxl,请先安装(或改用 txt/csv)")
                return
            wb = openpyxl.load_workbook(path, read_only=True, data_only=True)
            ws = wb.active
            rows_iter = ws.iter_rows(values_only=True)
            header = [str(c).lower().strip() if c is not None else "" for c in next(rows_iter, ())]
            url_col = next((i for i, c in enumerate(header)
                            if c in ("url", "link", "链接", "网址", "视频链接")), None)
            for row in rows_iter:
                if url_col is not None and url_col < len(row) and row[url_col]:
                    if looks_like_url(str(row[url_col])):
                        links.append(str(row[url_col]).strip())
                else:
                    for cell in row:
                        if cell and looks_like_url(str(cell)):
                            links.append(str(cell).strip())
                            break
        else:
            error("UNSUPPORTED_EXT", f"不支持的文件类型: {ext}(支持 txt / csv / xlsx / xls)")
            return
    except Exception as e:
        error("PARSE_ERROR", f"解析文件失败: {e}")
        return

    # 去重(保序)
    seen, out = set(), []
    for u in links:
        if u and u not in seen:
            seen.add(u)
            out.append(u)
    result({"links": out, "count": len(out), "file": path})


def main():
    argv = sys.argv[1:]
    if not argv:
        result({"usage": "download <info|download|import-file> --url URL [--category video|audio|image|live|subtitle] [--quality best|1080|720|480] [--output-dir DIR] [--cookies chrome|/path/to/cookies.txt] [--playlist 1] [--path FILE]"})
        return
    cmd = argv[0]
    args = parse_args(argv[1:])

    try:
        if cmd == "info":
            if not args.get("url"):
                error("MISSING_URL", "缺少 --url 参数")
                return
            info(args["url"], args.get("cookies", ""))
        elif cmd == "download":
            if not args.get("url"):
                error("MISSING_URL", "缺少 --url 参数")
                return
            out = args.get("output_dir") or os.path.join(os.path.expanduser("~"), "Downloads", "PlugKit")
            download(
                args["url"],
                args.get("category", CATEGORY_VIDEO),
                args.get("quality", "best"),
                out,
                args.get("extra", ""),
                args.get("cookies", ""),
                args.get("playlist", ""),
            )
        elif cmd == "import-file":
            if not args.get("path"):
                error("MISSING_PATH", "缺少 --path 参数")
                return
            import_file(args["path"])
        else:
            error("UNKNOWN_CMD", f"未知命令: {cmd}")
    except Exception as e:
        error("PLUGIN_ERROR", str(e))
        sys.exit(1)


if __name__ == "__main__":
    main()
